{
  "name": "poket-paylink-svc",
  "version": "0.1.0",
  "description": "Microservicio que automatiza la creación de Enlaces de Pago en Poket (portal.pagoconpoket.com) y los expone como una API HTTP con idempotencia",
  "keywords": [
    "poket",
    "pagoconpoket",
    "nicaragua",
    "paylink",
    "payment-link",
    "playwright",
    "rsc",
    "react-server-components",
    "fastify",
    "scraping"
  ],
  "license": "Apache-2.0",
  "author": "Matthew Reyes",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bymatt10/poket-paylink-svc.git"
  },
  "bugs": {
    "url": "https://github.com/Bymatt10/poket-paylink-svc/issues"
  },
  "homepage": "https://github.com/Bymatt10/poket-paylink-svc#readme",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "login:check": "tsx src/loginCheck.ts",
    "create:check": "tsx src/createCheck.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.0",
    "async-mutex": "^0.5.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.10.0",
    "ioredis": "^5.11.1",
    "p-queue": "^9.3.1",
    "pino": "^10.3.1",
    "playwright": "^1.61.1",
    "tsx": "^4.23.1",
    "zod": "^4.4.3"
  }
}
