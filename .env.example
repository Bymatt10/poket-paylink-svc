# Credenciales del portal Poket (login en frío)
POKET_USER=            # teléfono (sin código de país) o correo del comercio
POKET_CODE=            # código de acceso fijo de 6 dígitos (NO es OTP)
POKET_COUNTRY_CODE=+505
POKET_BASE_URL=https://portal.pagoconpoket.com

# Auth del propio servicio. Generar: openssl rand -hex 32
POKET_SVC_API_KEY=

# ── Secretos por archivo (recomendado en producción) ─────────────────────────
# En vez de dejar las credenciales en este .env plano, apuntá a un archivo con
# el valor. Sirve con Docker secrets (/run/secrets/...) o Kubernetes.
# Aplica a: POKET_USER, POKET_CODE, POKET_SVC_API_KEY, REDIS_PASSWORD,
# SWAGGER_PASSWORD. La variable directa gana si están las dos.
#POKET_CODE_FILE=/run/secrets/poket_code
#POKET_SVC_API_KEY_FILE=/run/secrets/poket_svc_api_key

# ── Fusible de monto ─────────────────────────────────────────────────────────
# Techo del daño si algo se descontrola (bug del consumidor, key filtrada).
# Montos por encima se rechazan con 400. En córdobas enteros.
MAX_AMOUNT=100000

# Marca el idempotencyKey dentro del concepto que va al portal ("ps5 #orden-1234"),
# para poder reconciliar a mano un fallo ambiguo antes de reintentar.
# OJO: el concepto lo ve quien paga. 'false' lo desactiva.
CONCEPT_MARKER=true

# Archivo JSONL de auditoría de enlaces creados. Si se deja vacío, el rastro va
# igual al log estructurado de stdout. En contenedor read-only necesita volumen.
#AUDIT_LOG_PATH=/var/log/poket/paylinks.jsonl

# TTL de los jobs del modo asíncrono (Prefer: respond-async).
JOB_TTL_SECONDS=86400

REDIS_URL=redis://localhost:6379
# Contraseña de Redis (prod). Generar: openssl rand -hex 24
# El compose de prod arma REDIS_URL con esta contraseña y sobreescribe el de arriba.
REDIS_PASSWORD=
PORT=8080
HOST=0.0.0.0            # 127.0.0.1 en local para no exponer a la LAN
LOG_LEVEL=info
SESSION_TTL_SECONDS=3600
MAX_CONCURRENCY=1

# Swagger: la doc /docs solo se sirve si SWAGGER_PASSWORD está seteada, y queda
# detrás de Basic Auth. Dejala vacía en producción para deshabilitar la doc.
SWAGGER_USER=admin
SWAGGER_PASSWORD=      # openssl rand -hex 16

# Playwright: 'false' para ver el navegador (debug), 'true' en producción
HEADLESS=true

RUN_SMOKE=0
