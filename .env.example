# Credenciales del portal Poket (login en frío)
POKET_USER=            # teléfono (sin código de país) o correo del comercio
POKET_CODE=            # código de acceso fijo de 6 dígitos (NO es OTP)
POKET_COUNTRY_CODE=+505
POKET_BASE_URL=https://portal.pagoconpoket.com

# Auth del propio servicio (usado en F4). Generar: openssl rand -hex 32
POKET_SVC_API_KEY=

REDIS_URL=redis://localhost:6379
# Contraseña de Redis (prod). Generar: openssl rand -hex 24
# El compose de prod arma REDIS_URL con esta contraseña y sobreescribe el de arriba.
REDIS_PASSWORD=
PORT=8080
HOST=0.0.0.0            # 127.0.0.1 en local para no exponer a la LAN
LOG_LEVEL=info
SESSION_TTL_SECONDS=3600
MAX_CONCURRENCY=1

# Swagger: la doc /docs solo se sirve si SWAGGER_PASSWORD está seteada, y queda
# detrás de Basic Auth. Dejala vacía en producción para deshabilitar la doc.
SWAGGER_USER=admin
SWAGGER_PASSWORD=      # openssl rand -hex 16

# Playwright: 'false' para ver el navegador (debug), 'true' en producción
HEADLESS=true

RUN_SMOKE=0
